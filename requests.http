@baseUrl = http://localhost:3000

### 1. Registrar

POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "name": "Caio", "email": "caio@example.com", "password": "senha-forte-123" }

#### 2. Login

# @name Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "caio@example.com", "password": "senha-forte-123" }

### 3. Quem sou eu

GET {{baseUrl}}/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTQyNTE3MTEsImV4cCI6MTc5NDI1NTMxMSwic3ViIjoiMSJ9.c-kVmuidCEmPrwprxe_4W5XjWmymJLLpCkDlhY1679c

### 4. Criar tarefa (com token)

POST {{baseUrl}}/tasks
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTQyNTE3MTEsImV4cCI6MTc5NDI1NTMxMSwic3ViIjoiMSJ9.c-kVmuidCEmPrwprxe_4W5XjWmymJLLpCkDlhY1679c
Content-Type: application/json

{ "title": "Estudar full-stack" }

### 5. Listar (com token)

GET {{baseUrl}}/tasks
Authorization: Bearer {{login.response.body.$.token}}

### 6. Sem token > 401

GET {{baseUrl}}/tasks

### 7. Token adulterado > 401

GET {{baseUrl}}/tasks
Authorization: Bearer abc.dfg.ghi

### 8. Senha errada > 401

POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "caio@example.com", "password": "senha-errada-123" }